# Copia esto a .env.local y pega tus valores de Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xyzcompany.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Clave para entrar al /admin — SOLO servidor, no lleva NEXT_PUBLIC_
# (se acepta la vieja NEXT_PUBLIC_ADMIN_KEY como transición)
# Genera una larga y aleatoria (p. ej. `openssl rand -hex 24`); nunca la subas a git
ADMIN_KEY=cambia-esto-por-una-clave-aleatoria
